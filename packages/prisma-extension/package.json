{
  "name": "@kuruwic/prisma-audit",
  "version": "0.1.6",
  "type": "module",
  "description": "Prisma extension for audit logging",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "prisma",
    "audit",
    "logging",
    "typescript",
    "extension"
  ],
  "author": "kuruwic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuruwic/prisma-audit.git"
  },
  "homepage": "https://github.com/kuruwic/prisma-audit#readme",
  "bugs": {
    "url": "https://github.com/kuruwic/prisma-audit/issues"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.10.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bugsnag/cuid": "^3.2.2",
    "@kuruwic/db-audit-core": "workspace:^",
    "@paralleldrive/cuid2": "^3.0.4",
    "debug": "^4.4.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@kuruwic/prisma-audit-typescript-config": "workspace:*",
    "@prisma/client": "7.10.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
