{
  "name": "@kuruwic/prisma-audit-generator",
  "version": "0.2.0",
  "type": "module",
  "description": "Prisma generator that emits the schema data @kuruwic/prisma-audit reads at runtime",
  "bin": {
    "prisma-audit-generator": "./bin/prisma-audit-generator.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "prisma",
    "generator",
    "audit",
    "logging"
  ],
  "author": "kuruwic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuruwic/prisma-audit.git"
  },
  "homepage": "https://github.com/kuruwic/prisma-audit#readme",
  "bugs": {
    "url": "https://github.com/kuruwic/prisma-audit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prisma/generator-helper": "^6.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@kuruwic/prisma-audit": "workspace:*",
    "@kuruwic/prisma-audit-typescript-config": "workspace:*",
    "@prisma/internals": "6.19.0",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
