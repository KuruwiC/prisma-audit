{
  "name": "@kuruwic/prisma-audit-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Prisma database schema and client for prisma-audit monorepo",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./generated/client": {
      "types": "./generated/client/client.ts",
      "import": "./generated/client/client.ts"
    },
    "./generated/audit": {
      "types": "./generated/audit/index.d.ts",
      "import": "./generated/audit/index.js"
    }
  },
  "files": [
    "dist",
    "generated",
    "prisma/schema.prisma",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@kuruwic/prisma-audit": "workspace:*",
    "@kuruwic/prisma-audit-generator": "workspace:*",
    "@kuruwic/prisma-audit-typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "dotenv": "^16.6.1",
    "prisma": "7.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
